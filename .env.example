# SentinelFlow AI Configuration

# Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database
# Default: SQLite file-based database for zero-config local run
DATABASE_URL=sqlite:///./sentinelflow.db
# PostgreSQL option:
# DATABASE_URL=postgresql://sentinel_user:sentinel_pass@localhost:5432/sentinelflow_db

# Security & Authentication
SECRET_KEY=sentinelflow_super_secure_demo_key_change_in_production_987234
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Detection & Ensemble Parameters
RULE_ENGINE_WEIGHT=0.30
BEHAVIORAL_ANOMALY_WEIGHT=0.25
SUPERVISED_MODEL_WEIGHT=0.25
GRAPH_INTELLIGENCE_WEIGHT=0.20

# Triage Thresholds
TRIAGE_ROUTINE_MAX=24
TRIAGE_LOW_MAX=49
TRIAGE_ELEVATED_MAX=74
TRIAGE_HIGH_MIN=75

# Self-Directed Agent Execution Bounds
MAX_GRAPH_DEPTH=3
MAX_ENTITIES_PER_INVESTIGATION=50
MAX_TRANSACTIONS_EXAMINED=200
MAX_EXECUTION_TIME_SECONDS=30

# Optional External LLM Integration (Fallback is active when empty)
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=

# Seed & Simulation Settings
SIMULATION_EMISSION_INTERVAL_MS=1500
SIMULATION_RANDOM_SEED=42
